{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feixuan.example/schemas/CFG-005_manifest.v1.schema.json",
  "title": "交付清单 (delivery manifest)",
  "description": "NORM-DELIVERY-001《分镜提示词交付规范 v1.3》（现行版）§1.4 的交付包清单定义（V1.1→V1.3 技术内容逐字未变、章节结构未变动，故 §1.4 编号继续有效；本 Schema 自身的 v1.1.0 修订号不变）。用于校验交付包完整性与四件套齐备（SW-014 / SW-026）。v1.1.0 变化：新增 quality_gate_report 随包留档项、quality_gate 质量门结论、units 单元摘要、human_review 人工核对记录；自检项 12 → 18；adapters.verify_status 增加 partial；fileEntry 增加 two_section（适配文件两段式）。",
  "type": "object",
  "required": ["manifest_version", "pack_id", "statement_id", "created_at", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "string", "const": "1.1.0" },
    "spec_version": { "type": "string", "description": "依据的规范版本，如 NORM-DELIVERY-001 v1.1" },
    "pack_id": { "type": "string", "minLength": 1 },
    "statement_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "provider": { "type": "string" },
    "artifacts": {
      "type": "object",
      "description": "交付四件套（四项必须存在）+ 质量门报告随包留档项（规范 §1.1）",
      "required": ["shot_prompt_pack", "aigc_meta", "overlay_assets", "compliance_statement"],
      "additionalProperties": false,
      "properties": {
        "shot_prompt_pack": { "$ref": "#/$defs/artifact" },
        "aigc_meta": { "$ref": "#/$defs/artifact" },
        "overlay_assets": { "$ref": "#/$defs/artifact" },
        "compliance_statement": { "$ref": "#/$defs/artifact" },
        "quality_gate_report": {
          "$ref": "#/$defs/artifact",
          "description": "v1.1 新增：qa/audit_report.txt 镜头语言质量门报告；不计入四件套，但缺失即阻断（规范 §8.3 第 13 项）"
        }
      }
    },
    "exports": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileEntry" },
      "default": []
    },
    "adapters": {
      "type": "array",
      "description": "生成的模型适配文件；含 verify_status 记录，pending/partial 时必须随附核对提示",
      "items": {
        "type": "object",
        "required": ["model_code", "file", "verify_status"],
        "additionalProperties": false,
        "properties": {
          "model_code": { "type": "string" },
          "model_display": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "file": { "type": "string" },
          "verify_status": { "type": "string", "enum": ["pending", "partial", "verified"] },
          "verify_pending": {
            "type": "array",
            "items": { "type": "string" },
            "description": "仍待核对的字段（verify_status=partial 时必填）"
          },
          "negative_prompt_supported": { "type": "boolean" },
          "negative_residue_check": {
            "type": "string",
            "enum": ["pass", "fail", "not_applicable"],
            "description": "模型不支持负向字段时，必须为 pass（规范 §8.3 第 17 项）"
          }
        }
      },
      "default": []
    },
    "units": {
      "type": "array",
      "description": "生成单元摘要（规范 §3.5 / §4.3）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit_id": { "type": "string" },
          "shot_count": { "type": "integer", "minimum": 2, "maximum": 3 },
          "duration_ms": { "type": "integer" },
          "camera_types": { "type": "array", "items": { "type": "string" } },
          "camera_types_unique": { "type": "boolean" }
        }
      },
      "default": []
    },
    "quality_gate": {
      "type": "object",
      "description": "镜头语言质量门结论（规范 §4.2 / §4.8）",
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "command": { "type": "string" },
        "scope": { "type": "string" },
        "passed": { "type": "boolean" },
        "thresholds": { "type": "object" },
        "measured": { "type": "object" },
        "report_file": { "type": "string" }
      }
    },
    "human_review": {
      "type": "array",
      "description": "人工核对记录（角色一致性 / 跨镜连续性）；须记结果 + 时间 + 检查人（规范 §8.3 第 18 项、§8.4）",
      "items": {
        "type": "object",
        "required": ["result", "checked_at", "operator"],
        "additionalProperties": false,
        "properties": {
          "no": { "type": "integer" },
          "item": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail", "warn"] },
          "checked_at": { "type": "string", "format": "date-time" },
          "operator": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" }
        }
      },
      "default": []
    },
    "self_check": {
      "type": "array",
      "description": "交付前自检 18 项结果（规范 §8.3）",
      "items": {
        "type": "object",
        "required": ["no", "item", "result"],
        "additionalProperties": false,
        "properties": {
          "no": { "type": "integer", "minimum": 1, "maximum": 18 },
          "item": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail", "warn"] },
          "detail": { "type": "string" }
        }
      },
      "default": []
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "months": { "type": "integer", "minimum": 6, "default": 6 },
        "note": { "type": "string" }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["present", "files"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "note": { "type": "string" }
      }
    },
    "fileEntry": {
      "type": "object",
      "required": ["file", "format"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "format": { "type": "string", "enum": ["json", "csv", "xlsx", "md", "txt", "pdf"] },
        "explicit_mark": { "type": "boolean", "description": "是否已注入显式标识；必须为 true（标识办法 §4 末段）" },
        "implicit_mark": { "type": "boolean", "description": "是否已注入隐式标识" },
        "two_section": { "type": "boolean", "description": "适配 TXT 是否为两段式（标识区 + 提示词区），规范 §6.8" },
        "note": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
