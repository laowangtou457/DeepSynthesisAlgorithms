# ============================================================
# 服务端骨架 · 环境变量样例（T-003 一期）
# ------------------------------------------------------------
# 用法：复制为 .env 后按环境填写。本文件只放**占位值**，
#       任何真实密钥、口令、内网地址一律不得写入本文件。
# 纪律：配置只从环境变量读取，不得在业务代码中内联硬编码。
# ============================================================

# ---- 应用 ----
APP_APP_NAME=AI 漫剧剧本与分镜提示词生成系统
APP_API_PREFIX=/api/v1
APP_DEBUG=false

# ---- 溯源留存日志（官方第 9 项 / T-090；SW-016 五要素）----
# 生成内容溯源日志的落盘目录。留空 ⇒ <工程根>/.wb-e2e/logs（.gitignore 内，不入库）。
# ⚠️ 官方要求「留存不少于六个月，提供截图」⇒ 部署机请指到**持久化大盘**，
#    不得指向临时目录（TMPDIR / tmpfs），否则重启即丢、交不了材料。
APP_LOG_DIR=
# 留存天数，默认 180（≥6 个月）。调小即违反官方要求，属受控变更（须记 ISSUE）。
APP_LOG_RETENTION_DAYS=180
# 是否落盘。生产必须 true；置 false 仅用于单测/CI 隔离（否则官方第 9 项交不了）。
APP_LOG_TO_FILE=true

# ---- 推理后端 ----
# 取值：mock | vllm | local | remote
# mock：全链路打通不依赖 GPU（离线联调、CI）；vllm：接真实模型（T-004 已接入）。
# 切换只改本项，业务代码零改动（见 app/inference/registry.py）。
APP_INFERENCE_BACKEND=mock

# ---- vLLM 后端（T-004 生成链路接入 / T-012 部署手册）----
# ⚠️ 平台前提：vLLM 仅支持 Linux / WSL2。服务进程跑在 WSL2 内、监听回环端口，
#    Windows 侧应用经 localhost 转发访问。启动参数见 04-部署运维/OPS-002。
# ⚠️ 地址与模型名一律来自本处，**不得在业务代码中硬编码**。
# ⚠️ 任何真实密钥不得写入本文件；本机部署无鉴权，留空即可。
APP_VLLM_BASE_URL=http://127.0.0.1:8001/v1
APP_VLLM_MODEL=Qwen2.5-7B-Instruct
APP_VLLM_API_KEY=
# **单次后端调用超时（秒）**（httpx 按每次 HTTP 请求计，见 ISSUE-048）。
# ⚠️ 原默认 180 与实测耗时重叠：shot_prompt 单次调用实测 167~304 s ⇒ 原值落在分布中部，
#    该段成败取决于当次输出长度 ⇒ **间歇性 502**（现场：latency_ms=180050、vllm_timeout）。
# 处置：上修为 600（＝实测最大值 304 s 上取整到整百后的约 2 倍档）。
# ⚠️ 重试会多次调用 ⇒ 单段最坏墙钟时间 ≈ APP_QUALITY_GATE_MAX_ATTEMPTS × 本值。
APP_VLLM_TIMEOUT_SECONDS=600
# 受约束解码策略（**版本敏感，切换前须核对目标 vLLM 版本**）：
#   structured_outputs = vLLM >= 0.12.0 官方形态（默认）
#   guided_json        = vLLM <  0.12.0 原生参数（发给新版会被静默忽略 → 无约束解码）
#   response_format    = OpenAI 标准 json_schema 形态（跨引擎最通用）
#   off                = 不约束（仅调试用）
# 交付包 JSON 的受约束采样依赖本项；置 off 即退化为「解析＋重试＋validate_pack 校验」。
APP_VLLM_GUIDED_DECODING_MODE=structured_outputs
# 单卡并发上限（SYS-015 暂定值，待 T-013 实测校准）
APP_VLLM_MAX_CONCURRENCY=10

# ---- 提示词资产根目录 ----
# 指向 03-工程代码/prompts（内含 CFG-008_manifest.yaml 与 templates/）。
# 留空时按「本文件所在包 → 工程根」自动定位。
APP_PROMPTS_ROOT=

# ---- 提示词输入体积（ISSUE-037 方案 D 的服务层一半）----
# 注入上游产物变量（*_json）前，对其 JSON 文本做**无损紧凑化**（只去空白，语义零改动）。
# 背景：TPL-009 原先把上游全文插入 5 次（渲染器对每一处 {name} 一律全量替换），
#   第 4 段真实输入 50,358 tokens ＋ 输出 8,192 ＝ 58,550，超 Qwen2.5-7B 原生上限 32768
#   ⇒ 该段在**引擎入口**被拒（502）。模板侧 v2.1.1 已改为「每变量各只注入一次」。
# 默认 true，不建议改 false：只去空白、键序键值不变、解析失败原样返回；
#   置 false 仅用于「原文即所见」的对照量测。
APP_PROMPT_COMPACT_UPSTREAM=true

# ---- 紧凑化的适用阶段（ISSUE-044，逗号分隔；空串＝不适用任何阶段）----
# ⚠️ 为什么要"按段"：紧凑化的**唯一动机**是"某段渲染输入超窗"，而实测只有 shot_prompt 段
#   会超（未紧凑 58,550 > 32,768）；storyboard 段输入仅 12,214 tokens、**不需要**它。
# ⚠️ 实测对照（n=6/格）：分镜段存在"只覆盖第 1 场的 3 镜/1 单元"吸引子——不带受约束解码时
#   6/6 稳定落入；带约束时 12 次中 5 次逃出。紧凑化在带约束时表现为**疑似**劣化
#   （越阈值 4/6 → 1/6），⚠️ Fisher 单侧 p≈0.24、不显著 ⇒ 只按"谁需要谁才用"收窄，
#   **不宣称**已证明因果。方案 D 的目的（救第 4 段超窗）不受影响。
APP_PROMPT_COMPACT_STAGES=shot_prompt

# ---- 产物形态闸（ISSUE-042 根治）----
# 生成链路的产物形态契约判定（受约束解码 / 生成后自检 / 上游准入三处共用的真值，
# 见 app/services/artifact_contract.py）。
# ⚠️ 默认 true。置 false 时判定照常执行并留痕（artifact_shape_checked=true、
#    enforced=false），但不阻断后续生成与状态机推进——该状态会体现在
#    生成日志的 artifact_shape_enforced 字段中，不得静默。
# ⚠️ 背景：实测分镜段曾产出被截断的 JSON（finish_reason=stop 却远未触 max_tokens），
#    却照常入库并驱动下游，令「承继守恒」在源头不可验证。
APP_SHAPE_GATE_ENFORCE=true

# ---- 生成后质量门禁 ＋ 不过即重试回路（T-086；ISSUE-038 的链路侧一半）----
# 在「生成后、入库前」调用工程侧门禁判据（唯一来源 03-工程代码/prompts/validate_output.py
# 的 R1~R40；服务层不抄第二份）＋ 交付侧门禁（delivery/validate_pack.py 的 BLOCK）。
# 形态闸（APP_SHAPE_GATE_ENFORCE）管**结构**，本组管**质量**，两者是两层、都要。
APP_QUALITY_GATE_ENABLED=true
# 适用的阶段（逗号分隔；空串＝不适用任何阶段）。
# ⚠️ 默认只对 storyboard / shot_prompt 两段启用：ISSUE-038 的实测失败全部落在这两段，
#    对上游段重复设闸只增加重试成本（同一处错误在分镜段会被同一判据再次抓到）。
APP_QUALITY_GATE_STAGES=storyboard,shot_prompt
# ★ 阻断执行开关（项目方 2026-10-16 裁决"分阶段上线"）：
#   true  = 门禁结论生效，用尽重试仍不过则**如实拒绝**（不写产物槽、不推进状态机）；
#   false = **只判定、只留痕、不阻断**（受控旁路）——**当前默认**。
# ⚠️ 为什么默认关：实测产物级直出率 passed=true = 0/3（ISSUE-038），此刻就拦会让四段生成
#    大概率全部被拒 ⇒ 链路不可用。故先建成回路并用真实数据检验，待 T-087（资产侧提质）
#    把直出率抬起来后再翻 true。置 false 时判定照常执行并留痕（enforced=false），不得静默。
APP_QUALITY_GATE_ENFORCE=false
# ★ 重试回路开关（与上面两项分开）。
#   true  = 门禁不过时按 APP_QUALITY_GATE_MAX_ATTEMPTS 重试；false = 只判一次、不重试。
# ⚠️ 为什么默认关：实测直出率 0/3 ⇒ 几乎每次都走到重试，而 shot_prompt 单段约 304 s、
#    storyboard 约 130 s ⇒ 开着重试等于这两段各跑两遍。在 enforce=false 期间，重试不改变
#    "是否入库"、只改变"入库的是哪一版" ⇒ 收益与成倍耗时不成比例。
#    ⇒ 建议与 APP_QUALITY_GATE_ENFORCE 同时在 T-087 完成后打开；
#      或先打开本项做**收敛性实测**（T-086 待办项），量出"重试后通过率"再决定。
APP_QUALITY_GATE_RETRY_ENABLED=false
# 重试上限（含首次；2 = 首次 ＋ 1 次重试）。项目方 2026-10-16 裁决取 2。
# ⚠️ 必须有上限，且用尽即如实拒绝 —— 否则本回路会退化为"以重试掩盖不合格产物"。
APP_QUALITY_GATE_MAX_ATTEMPTS=2
# 重试粒度：segment = 只重跑定位到的失败段（默认）；stage = 整阶段重跑。
# ⚠️ 定位依赖"门禁报错消息 → 段"的映射（unit:Uxx / package_head）；映射不到一律回退为
#    全部段（宁可多跑、不得漏跑），并在产物留痕里记 retry_degraded_fallback / scope_fallback。
APP_QUALITY_GATE_RETRY_SCOPE=segment
# 是否同时跑交付层门禁（validate_pack.py 的 BLOCK 判据）。PRO-006 §7 的验收判据原文
# 针对的正是它（"交付包经 validate_pack.py 门禁 0 BLOCK"），工程侧门禁判的是另一层，两者都要。
APP_QUALITY_GATE_PACK_CHECK=true

# ---- 分镜段派生量回填（R14；项目方 2026-11-04 裁决）----
# true = 生成后、门禁前，把 total_duration_ms 按 Σ shots[].duration_ms 重算并回填；
#   false = 不动产物（只留原值，由 R14 如实判失败）。
# ⚠️ 为什么必须换机制：它是跨字段算术（"等于另一组字段之和"），JSON Schema / 受约束解码
#    在结构上表达不了；提示词路线已四版四错（v2.2.0 散文条款 / v2.2.1 给自洽字面值 18200 /
#    v2.2.2 归零 + 算式紧邻示例），真机三种样本 3/3 产物 total_duration_ms 恒为 0（照抄骨架）。
# ⚠️ 这不是"改判据"：R14 一字未动，回填后判的是"回填结果是否守恒"；模型原值完整留痕在
#    artifact["derived_backfill"]（original / computed / changed），审计可查"模型填了什么、
#    服务层改成了什么"。
APP_STORYBOARD_DERIVED_BACKFILL=true

# ---- 服务层元数据真值覆盖（T-086 配套；项目方 2026-10-16 裁决"服务层强制覆盖"）----
# true = 交付包生成后，由服务层以自己算出的 pack_meta 覆盖模型自述的 meta（pack_id /
#   created_at / task_type / generator / generation_trace / compliance）与 aigc_meta.AIGC
#   （标识块），模型自拟值一律丢弃。
# ⚠️ 为什么必须做（实测发现，合规级）：服务层刻意留的占位（safety_check:"占位（内容安全双闸
#    未接入）"、marking_check:"占位"、statement_id:"{{STATEMENT_ID}}"）在真实产物里被模型
#    替换成了看起来已通过的**假值** —— safety_check:"passed"（还带时间戳）、
#    copyright_check:"passed"、marking_check.explicit:"present"、statement_id:"ST-001"。
#    ⇒ 客户拿到的产物看起来已过内容安全与标识校验，而平台根本没做。这比"缺失"更危险
#    （缺失会被门禁拦下，假值会**通过**门禁）⇒ 合规字段的写入权必须归服务层。
# ⚠️ 覆盖只针对服务层域字段；模型可影响的字段（title / notes / shots /
#    units …）一字不改（不覆盖、也不补 model 没输出的键 —— 缺键本身是 R27/R30 的判据）。
# ⚠️ 唯一例外是 `total_duration_ms`，且**不在本开关内**：它由
#    `APP_STORYBOARD_DERIVED_BACKFILL` 单独控制（见上），因为它是**派生量**而非服务层域真值。
APP_SERVICE_TRUTH_OVERRIDE=true
# 对外能力声明（逗号分隔的任务类型码，写入交付包 meta.unsupported_task_types）。
# 语义＝"本期不支持的任务类型"，CFG-006 schema 要求非空（留空会让客户以为支持）。
# ⚠️ 默认空 = 服务层不声明（不替项目方做产品口径声明）；此时保留模型已声明的值。
# ⇒ 要稳定满足 schema 的 minItems:1，应由部署侧显式配置（内容属**产品口径**，须项目方确认）。
APP_UNSUPPORTED_TASK_TYPES=

# ---- 会话 ----
# 会话超时秒数（SW-001「会话超时恢复」）；超时后会话可被恢复或重建。
APP_SESSION_TTL_SECONDS=3600

# ---- 身份与租户（T-008 二期接入，本批只保留配置位）----
APP_AUTH_ENABLED=false

# ---- 内容安全双闸（T-005；SW-009 / SW-010 / SW-011 / SW-017）----
# 关键词库根目录；留空时按工程布局定位 09-合规资料库/01-关键词库。
APP_LEXICON_ROOT=
# **受控词库目录**（项目方 2026-10-15 决策：受控内容**不入库**，运行时读受控区）。
# 留空时取 E:/_受控区/lexicon_controlled；⚠️ 该目录不受版本控制，部署时须保证存在。
APP_CONTROLLED_LEXICON_ROOT=
# **阻断执行开关**：true=生成链路据 verdict 阻断；false=只判定不阻断（联调旁路）。
# ⚠️ 默认 true；置 false 时检测照常执行并留痕，但放行不做阻断，该状态会出现在
#    /api/v1/safety/policy 的 enforced 字段与启动日志中，不得静默。
APP_GUARD_ENFORCE=true
# fail-closed：检测不可用（词库零词条/加载失败）时拒绝放行。
# ⚠️ 改为 false 等于「检测失效即放行」，与 SW-009 异常列相悖，仅供本地调试。
APP_GUARD_FAIL_CLOSED=true
# 输出闸命中处置策略：block 拦截 / flag 放行并打标（SW-010）。
# ⚠️ replace 已按 2026-10-16 项目方裁决删除（原实现只返回提示语、并未真替换文本）。
APP_GUARD_OUTPUT_ACTION=block
# 单次检测最多返回的命中类别数。
APP_GUARD_MAX_HITS=20
# ---- SW-017 兜底话术（可配置、可审计）----
# ⚠️ 留空 = 回落服务层内置默认（推荐留空，改话术请改本文件而非代码）。
# 执行期**不调推理后端**：安全兜底必须在后端不可用时仍能工作。
# ⚠️ 中文含标点，建议用双引号包裹以免被 dotenv 解析歧义。
APP_GUARD_REFUSAL_TALK=
APP_GUARD_CLARIFY_TALK=
